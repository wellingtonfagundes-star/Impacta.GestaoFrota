@model Impacta.GestaoFrota.UI.Models.LoginViewModel
@{
    ViewData["Title"] = "Acesso ao sistema";
}

<section class="crud-page" aria-labelledby="page-title">
    <div class="crud-header">
        <div>
            <p class="crud-kicker"><i class="bi bi-shield-lock-fill me-2"></i>Autenticação</p>
            <h1 id="page-title" class="crud-title">Acesso ao sistema</h1>
            <p class="crud-subtitle">Informe suas credenciais para acessar o portal de gestão de frotas.</p>
        </div>
    </div>

    <div class="crud-card narrow-crud-page mx-auto">
        <div class="crud-card-heading">
            <div>
                <span class="crud-card-icon"><i class="bi bi-truck-front-fill"></i></span>
                <span>Credenciais de acesso</span>
            </div>
            <span class="crud-count">Microsoft Identity</span>
        </div>

        <div class="p-4 p-md-4">
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" placeholder="usuario@dominio.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <div class="crud-form-actions mt-0">
                    <button type="submit" class="btn btn-primary">Entrar</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
