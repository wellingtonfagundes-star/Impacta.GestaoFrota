@model Impacta.GestaoFrota.Application.ViewModel.StatusFrotaViewModel

@{
    ViewData["Title"] = "Excluir status da frota";
}

<section class="crud-page narrow-crud-page" aria-labelledby="page-title">
    <div class="crud-header">
        <div>
            <p class="crud-kicker text-danger"><i class="bi bi-trash3 me-2"></i>Status da Frota</p>
            <h1 id="page-title" class="crud-title">Excluir status</h1>
            <p class="crud-subtitle">Confirme a remoção do cadastro abaixo.</p>
        </div>
    </div>
    <div class="crud-form-card delete-card">
        <div class="delete-warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div><strong>Esta ação não pode ser desfeita.</strong><p class="mb-0">A exclusão pode não ser permitida se o status estiver associado a veículos.</p></div>
        </div>
        <dl class="row delete-details mb-4">
            <dt class="col-sm-4">Nome</dt><dd class="col-sm-8">@Model.NomeStatus</dd>
            <dt class="col-sm-4">Descrição</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Descricao) ? "—" : Model.Descricao)</dd>
        </dl>
        <form asp-action="Delete" method="post">
            <input asp-for="IdStatusFrota" type="hidden" />
            <div class="crud-form-actions">
                <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-2"></i>Cancelar</a>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-2"></i>Excluir status</button>
            </div>
        </form>
    </div>
</section>
