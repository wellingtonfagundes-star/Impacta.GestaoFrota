@model Impacta.GestaoFrota.Application.ViewModel.VeiculoBeneficioViewModel

@{
    ViewData["Title"] = "Novo benefício de veículo";
}

<section class="crud-page">
    <div class="crud-header"><div><p class="crud-kicker">Parametrizações</p><h1 class="crud-title">Novo benefício de veículo</h1></div></div>
    <div class="crud-card p-4">
        <form asp-action="Create" method="post" data-person-form>
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2 justify-content-end">
                <a asp-action="Index" class="btn btn-light">Cancelar</a>
                <button type="submit" class="btn btn-primary">Salvar benefício</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/beneficio-veiculo.js" asp-append-version="true"></script>
}