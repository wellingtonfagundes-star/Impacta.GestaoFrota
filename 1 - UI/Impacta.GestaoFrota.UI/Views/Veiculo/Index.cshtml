@model IEnumerable<Impacta.GestaoFrota.Application.ViewModel.VeiculoViewModel>

@{
    ViewData["Title"] = "Veículos";
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var totalRegistros = (int)(ViewBag.TotalRegistros ?? 0);
    var totalPaginas = (int)(ViewBag.TotalPaginas ?? 1);
    var search = (string)(ViewBag.Search ?? "");
}

<section class="crud-page" aria-labelledby="page-title">
    <div class="crud-header">
        <div>
            <p class="crud-kicker"><i class="bi bi-folder2-open me-2"></i>Cadastros</p>
            <h1 id="page-title" class="crud-title">Veículos</h1>
            <p class="crud-subtitle">Gerencie os veículos disponíveis na sua frota.</p>
        </div>
        <a class="btn btn-primary crud-action" href="#" data-modal-url="@Url.Action("Create")">
            <i class="bi bi-plus-circle me-2"></i>Novo veículo
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success crud-alert" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger crud-alert" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i>@errorMessage
        </div>
    }

    <div class="crud-card">
        <div class="crud-card-heading">
            <div>
                <span class="crud-card-icon"><i class="bi bi-car-front"></i></span>
                <span>Veículos cadastrados</span>
            </div>
            <span class="crud-count">@totalRegistros registros</span>
        </div>

        <div class="card-body border-bottom">
            <form asp-action="Index" asp-route-pageSize="@pageSize" method="get" class="d-flex gap-2">
                <div class="flex-grow-1">
                    <input type="text"
                           name="search"
                           class="form-control form-control-sm"
                           placeholder="Pesquisar por placa, fabricante ou identificação..."
                           value="@search"
                           aria-label="Pesquisar veículos">
                </div>
                <button type="submit" class="btn btn-primary btn-sm" title="Pesquisar">
                    <i class="bi bi-search"></i>
                    <span class="ms-1 d-none d-md-inline">Pesquisar</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <a asp-action="Index" asp-route-pageSize="@pageSize" class="btn btn-outline-secondary btn-sm" title="Limpar pesquisa">
                        <i class="bi bi-x-circle"></i>
                        <span class="ms-1 d-none d-md-inline">Limpar</span>
                    </a>
                }
            </form>
        </div>

        @if (Model is null || !Model.Any())
        {
            <div class="crud-empty">
                <i class="bi bi-inbox"></i>
                <h2>Nenhum veículo cadastrado</h2>
                <p>Comece adicionando um novo veículo para a sua frota.</p>
                <a class="btn btn-outline-primary" href="#" data-modal-url="@Url.Action("Create")">Cadastrar veículo</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table crud-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Placa</th>
                            <th scope="col">Fabricante</th>
                            <th scope="col">Identificação</th>
                            <th scope="col">Ano</th>
                            <th scope="col">Tipo</th>
                            <th scope="col" class="text-center">KM</th>
                            <th scope="col" class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Placa</td>
                                <td>@item.Fabricante</td>
                                <td>@item.NrIdentificacao</td>
                                <td>@item.AnoModelo</td>
                                <td>
                                    <span class="badge text-bg-info">@item.TipoVeiculo</span>
                                </td>
                                <td class="text-center">@item.KmAtual.ToString("N0")</td>
                                <td class="text-end">
                                    <div class="crud-row-actions">
                                        <a class="btn btn-sm btn-outline-primary" href="#" data-modal-url="@Url.Action("Edit", new { id = item.IdVeiculo })" title="Editar">
                                            <i class="bi bi-pencil-square"></i><span class="visually-hidden">Editar</span>
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger" href="#" data-modal-url="@Url.Action("Delete", new { id = item.IdVeiculo })" title="Excluir">
                                            <i class="bi bi-trash3"></i><span class="visually-hidden">Excluir</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="operationMessage" class="position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

            @if (totalPaginas > 1)
            {
                <nav class="p-3 border-top" aria-label="Paginação de veículos">
                    <ul class="pagination justify-content-end mb-0">
                        <li class="page-item @(page == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(page - 1)" asp-route-pageSize="@pageSize" asp-route-search="@search">Anterior</a>
                        </li>
                        @for (var pagina = 1; pagina <= totalPaginas; pagina++)
                        {
                            <li class="page-item @(pagina == page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@pagina" asp-route-pageSize="@pageSize" asp-route-search="@search">@pagina</a>
                            </li>
                        }
                        <li class="page-item @(page == totalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(page + 1)" asp-route-pageSize="@pageSize" asp-route-search="@search">Próxima</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</section>

<div class="modal fade" id="veiculoModal" tabindex="-1" aria-labelledby="veiculoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="veiculoModalContent"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const modalElement = document.getElementById('veiculoModal');
            const modalContent = document.getElementById('veiculoModalContent');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

            document.querySelectorAll('.crud-alert').forEach(alert => {
                setTimeout(() => {
                    bootstrap.Alert.getOrCreateInstance(alert).close();
                }, 4000);
            });

            async function loadModal(url) {
                modalContent.innerHTML = '<div class="modal-body text-center p-5"><span class="spinner-border text-primary" role="status"></span></div>';
                modal.show();

                const response = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) {
                    modalContent.innerHTML = '<div class="modal-body"><div class="alert alert-danger mb-0">Não foi possível carregar o formulário.</div></div>';
                    return;
                }

                modalContent.innerHTML = await response.text();
                bindForm();
                parseValidation();
            }

            function parseValidation() {
                const form = modalContent.querySelector('[data-modal-form]');
                if (form && window.jQuery && $.validator && $.validator.unobtrusive) {
                    $.validator.unobtrusive.parse(form);
                }
            }

            function showOperationMessage(type, message) {
                const container = document.getElementById('operationMessage');
                container.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show shadow" role="alert">
                    <i class="bi bi-${type === 'success' ? 'check-circle-fill' : 'exclamation-circle-fill'} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>`;

                setTimeout(() => {
                    const alert = container.querySelector('.alert');
                    if (alert) bootstrap.Alert.getOrCreateInstance(alert).close();
                }, 4000);
            }

            function bindForm() {
                const form = modalContent.querySelector('[data-modal-form]');
                const deleteForm = modalContent.querySelector('[data-delete-form]');

                if (deleteForm) {
                    deleteForm.addEventListener('submit', async event => {
                        event.preventDefault();
                        const button = deleteForm.querySelector('button[type="submit"]');
                        button.disabled = true;

                        const response = await fetch(deleteForm.action, {
                            method: 'POST',
                            body: new FormData(deleteForm),
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        const result = await response.json();

                        modal.hide();
                        showOperationMessage(result.success ? 'success' : 'danger', result.message);

                        if (result.success) {
                            setTimeout(() => window.location.reload(), 4000);
                        } else {
                            button.disabled = false;
                        }
                    });
                    return;
                }

                if (!form) return;

                form.addEventListener('submit', async event => {
                    event.preventDefault();
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    const result = await response.json();

                    // Se é sucesso, fechar modal e mostrar mensagem
                    if (result.success) {
                        modal.hide();
                        showOperationMessage('success', result.message);
                        // Recarregar a página após alguns segundos
                        setTimeout(() => window.location.reload(), 4000);
                    } else {
                        // Se é erro, mostrar mensagem de erro
                        showOperationMessage('danger', result.message);
                    }
                });
            }

            document.querySelectorAll('[data-modal-url]').forEach(button => {
                button.addEventListener('click', event => {
                    event.preventDefault();
                    loadModal(button.dataset.modalUrl);
                });
            });
        })();
    </script>
}
