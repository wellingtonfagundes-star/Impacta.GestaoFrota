@model IEnumerable<Impacta.GestaoFrota.Application.ViewModel.ReservaAprovadaConsultaViewModel>

@{
    ViewData["Title"] = "Reservas Aprovadas";
}

<section class="crud-page" aria-labelledby="page-title">
    <div class="crud-header">
        <div>
            <p class="crud-kicker"><i class="bi bi-calendar2-check-fill me-2"></i>Consultas</p>
            <h1 id="page-title" class="crud-title">Reservas Aprovadas</h1>
            <p class="crud-subtitle">Consulte as reservas aprovadas e seus responsáveis.</p>
        </div>
        <button type="button" class="btn btn-outline-danger print-action" onclick="window.print()">
            <i class="bi bi-file-earmark-pdf me-2"></i>Imprimir PDF
        </button>
    </div>

    <div class="crud-card">
        <div class="crud-card-heading">
            <div><span class="crud-card-icon"><i class="bi bi-calendar2-check"></i></span><span>Resultado da consulta</span></div>
            <span class="crud-count">@Model.Count() reservas</span>
        </div>
        @if (!Model.Any())
        {
            <div class="crud-empty">
                <i class="bi bi-inbox"></i>
                <h2>Nenhuma reserva aprovada</h2>
                <p>Não há reservas aprovadas para exibir.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table crud-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Solicitante</th>
                            <th>Aprovador</th>
                            <th>Data</th>
                            <th class="text-end">KM Estimada</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reserva in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@reserva.IdReserva</td>
                                <td>@reserva.Solicitante</td>
                                <td>@reserva.Aprovador</td>
                                <td>@(reserva.Data?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td class="text-end">@(reserva.KmEstimada?.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
