@model Impacta.GestaoFrota.Application.ViewModel.LocalAssistenciaViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input asp-for="IdLocal" type="hidden" />

<div class="mb-3">
    <label asp-for="Nome" class="form-label">Nome do local</label>
    <input asp-for="Nome" class="form-control" placeholder="Informe o nome do local" autofocus />
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Endereco" class="form-label">Endereço</label>
    <input asp-for="Endereco" class="form-control" placeholder="Informe o endereço" />
    <span asp-validation-for="Endereco" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Telefone" class="form-label">Telefone</label>
        <input asp-for="Telefone" class="form-control" placeholder="Informe o telefone" />
        <span asp-validation-for="Telefone" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="NomeContato" class="form-label">Nome do contato</label>
        <input asp-for="NomeContato" class="form-control" placeholder="Informe o nome do contato" />
        <span asp-validation-for="NomeContato" class="text-danger"></span>
    </div>
</div>

<div class="mb-0">
    <label asp-for="DescrServico" class="form-label">Serviços oferecidos</label>
    <textarea asp-for="DescrServico" class="form-control" rows="4" placeholder="Descreva os serviços de assistência"></textarea>
    <span asp-validation-for="DescrServico" class="text-danger"></span>
</div>
