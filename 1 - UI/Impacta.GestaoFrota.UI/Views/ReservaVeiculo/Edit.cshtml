@model Impacta.GestaoFrota.Application.ViewModel.ReservaVeiculoViewModel

@{
    ViewData["Title"] = "Editar Reserva de Veículo";
}

<section class="crud-page">
    <div class="crud-header">
        <div>
            <p class="crud-kicker"><i class="bi bi-calendar2-check-fill me-2"></i>Movimentações</p>
            <h1 class="crud-title">Editar Reserva #@Model.IdReserva</h1>
            <p class="crud-subtitle">Atualize os dados da reserva ou registre a devolução e a vistoria do veículo.</p>
        </div>
    </div>
    <div class="crud-card p-4">
        <form asp-action="Edit" asp-route-id="@Model.IdReserva" method="post">
            <partial name="_Form" model="Model" />
            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-2"></i>Salvar alterações</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/reserva-veiculo.js" asp-append-version="true"></script>
}
