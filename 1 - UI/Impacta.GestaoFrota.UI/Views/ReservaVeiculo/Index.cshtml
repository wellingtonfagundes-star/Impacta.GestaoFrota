@model IEnumerable<Impacta.GestaoFrota.Application.ViewModel.ReservaVeiculoViewModel>

@{
    ViewData["Title"] = "Reserva de Veículos";
}

<section class="crud-page" aria-labelledby="page-title">
    <div class="crud-header">
        <div>
            <p class="crud-kicker"><i class="bi bi-calendar2-check-fill me-2"></i>Movimentações</p>
            <h1 id="page-title" class="crud-title">Reserva de Veículos</h1>
            <p class="crud-subtitle">Gerencie reservas, retiradas e devoluções da frota.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary crud-action">
            <i class="bi bi-plus-circle me-2"></i>Nova reserva
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success crud-alert" role="alert">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger crud-alert" role="alert">@errorMessage</div>
    }

    <div class="crud-card">
        <div class="crud-card-heading">
            <div><span class="crud-card-icon"><i class="bi bi-calendar2-check"></i></span><span>Reservas cadastradas</span></div>
            <span class="crud-count">@Model.Count() registros</span>
        </div>
        @if (!Model.Any())
        {
            <div class="crud-empty">
                <i class="bi bi-inbox"></i>
                <h2>Nenhuma reserva cadastrada</h2>
                <p>Cadastre uma reserva para iniciar o acompanhamento do veículo.</p>
                <a asp-action="Create" class="btn btn-outline-primary">Cadastrar reserva</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table crud-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Veículo</th>
                            <th>Cliente</th>
                            <th>Funcionário Aprovador</th>
                            <th>Local Destino</th>
                            <th>Data</th>
                            <th>Local Retorno</th>
                            <th>Data Retorno</th>
                            <th class="text-end">Km Retorno</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.IdReserva</td>
                                <td>@item.VeiculoNome - @item.VeiculoPlaca</td>
                                <td>@item.ClienteNome</td>
                                <td>@item.FuncionarioAprovadorNome</td>
                                <td>@item.LocalDestinoNome</td>
                                <td>@item.Data?.ToString("dd/MM/yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(item.LocalRetornoNome) ? "—" : item.LocalRetornoNome)</td>
                                <td>@(item.DataRetorno?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td class="text-end">@(item.KmRetorno?.ToString("N2") ?? "—")</td>
                                <td class="text-end">
                                    <div class="crud-row-actions">
                                        <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil-square"></i><span class="visually-hidden">Editar</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-danger" title="Excluir">
                                            <i class="bi bi-trash3"></i><span class="visually-hidden">Excluir</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
