@model Impacta.GestaoFrota.Application.ViewModel.ReservaVeiculoViewModel

@{
    ViewData["Title"] = "Excluir Reserva de Veículo";
}

<section class="crud-page">
    <div class="crud-header">
        <div>
            <p class="crud-kicker"><i class="bi bi-calendar2-check-fill me-2"></i>Movimentações</p>
            <h1 class="crud-title">Excluir Reserva #@Model.IdReserva</h1>
            <p class="crud-subtitle">Esta ação também removerá o retorno e a vistoria associados.</p>
        </div>
    </div>
    <div class="crud-card p-4">
        <p>Confirma a exclusão da reserva do veículo <strong>@Model.VeiculoNome - @Model.VeiculoPlaca</strong>?</p>
        <form asp-action="Delete" asp-route-id="@Model.IdReserva" method="post">
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-2"></i>Excluir</button>
            </div>
        </form>
    </div>
</section>
