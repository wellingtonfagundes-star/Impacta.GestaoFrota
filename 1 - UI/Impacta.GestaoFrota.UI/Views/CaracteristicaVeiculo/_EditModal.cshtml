@model Impacta.GestaoFrota.Application.ViewModel.CaracteristicaVeiculoViewModel

<div class="modal-header">
    <h5 class="modal-title" id="caracteristicaVeiculoModalLabel">
        <i class="bi bi-pencil-square me-2"></i>Editar parametrização
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
</div>
<form asp-action="Edit" asp-route-idVeiculo="@Model.IdVeiculo" asp-route-idCaracteristica="@Model.IdCaracteristica" method="post" data-modal-form>
    <div class="modal-body">
        <partial name="_Form" model="Model" />
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2-circle me-2"></i>Salvar alterações
        </button>
    </div>
</form>
