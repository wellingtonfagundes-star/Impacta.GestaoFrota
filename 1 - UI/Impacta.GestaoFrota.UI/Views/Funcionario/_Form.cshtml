@model Impacta.GestaoFrota.Application.ViewModel.FuncionarioViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input asp-for="IdFuncionario" type="hidden" />

<div class="mb-3">
    <label asp-for="Matricula" class="form-label">Matrícula</label>
    <input asp-for="Matricula" class="form-control" readonly placeholder="Gerada automaticamente após salvar" />
    @if (Model.IdFuncionario == 0)
    {
        <div class="form-text">A matrícula será gerada automaticamente no formato MAT0007, usando o código criado no banco.</div>
    }
</div>

<div class="mb-3">
    <label asp-for="Nome" class="form-label">Nome completo</label>
    <input asp-for="Nome" class="form-control" placeholder="Informe o nome completo" autofocus />
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="Endereco" class="form-label">Endereço</label>
        <input asp-for="Endereco" class="form-control" placeholder="Informe o endereço" />
        <span asp-validation-for="Endereco" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Bairro" class="form-label">Bairro</label>
        <input asp-for="Bairro" class="form-control" placeholder="Informe o bairro" />
        <span asp-validation-for="Bairro" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-5 mb-3">
        <label asp-for="Cidade" class="form-label">Cidade</label>
        <input asp-for="Cidade" class="form-control" placeholder="Informe a cidade" />
        <span asp-validation-for="Cidade" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" class="form-select">
            <option value="">Selecione o estado</option>
            <option value="AC">AC</option>
            <option value="AL">AL</option>
            <option value="AP">AP</option>
            <option value="AM">AM</option>
            <option value="BA">BA</option>
            <option value="CE">CE</option>
            <option value="DF">DF</option>
            <option value="ES">ES</option>
            <option value="GO">GO</option>
            <option value="MA">MA</option>
            <option value="MT">MT</option>
            <option value="MS">MS</option>
            <option value="MG">MG</option>
            <option value="PA">PA</option>
            <option value="PB">PB</option>
            <option value="PR">PR</option>
            <option value="PE">PE</option>
            <option value="PI">PI</option>
            <option value="RJ">RJ</option>
            <option value="RN">RN</option>
            <option value="RS">RS</option>
            <option value="RO">RO</option>
            <option value="RR">RR</option>
            <option value="SC">SC</option>
            <option value="SP">SP</option>
            <option value="SE">SE</option>
            <option value="TO">TO</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Cep" class="form-label">CEP</label>
        <input asp-for="Cep" class="form-control" placeholder="Informe o CEP" />
        <span asp-validation-for="Cep" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-0">
        <label asp-for="Cpf" class="form-label">CPF</label>
        <input asp-for="Cpf" class="form-control" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" autocomplete="off" data-cpf-input data-val-cpf="O CPF informado é inválido." />
        <span asp-validation-for="Cpf" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-0">
        <label asp-for="Sexo" class="form-label">Sexo</label>
        <select asp-for="Sexo" class="form-select">
            <option value="">Selecione</option>
            <option value="M">Masculino</option>
            <option value="F">Feminino</option>
        </select>
        <span asp-validation-for="Sexo" class="text-danger"></span>
    </div>
</div>
