@using Impacta.GestaoFrota.UI.Security
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(RoleNames.Administrador);
    var isFuncionario = User.IsInRole(RoleNames.Funcionario);
    var isOperacional = isAdmin || isFuncionario;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Impacta.GestaoFrota.UI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Impacta.GestaoFrota.UI.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid app-container">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-truck-front-fill"></i></span>
                    <span>
                        <strong>Impacta</strong>
                        <small>Gestão de Frota</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                        aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="cadastrosMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-folder2-open me-1"></i>Cadastros
                                </a>
                                <ul class="dropdown-menu app-dropdown" aria-labelledby="cadastrosMenu">
                                    @if (isOperacional)
                                    {
                                        <li><h6 class="dropdown-header">Cadastros principais</h6></li>
                                        <li><a class="dropdown-item" asp-controller="Veiculo" asp-action="Index"><i class="bi bi-car-front-fill"></i>Veículos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Caracteristica" asp-action="Index"><i class="bi bi-list-check"></i>Características</a></li>
                                        <li><a class="dropdown-item" asp-controller="Cliente" asp-action="Index"><i class="bi bi-people-fill"></i>Clientes</a></li>
                                    }
                                    @if (isAdmin)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Funcionario" asp-action="Index"><i class="bi bi-person-badge-fill"></i>Funcionários</a></li>
                                    }
                                    @if (isOperacional)
                                    {
                                        <li><h6 class="dropdown-header">Cadastros operacionais</h6></li>
                                        <li><a class="dropdown-item" asp-controller="BeneficiarioVeiculo" asp-action="Index"><i class="bi bi-car-front-fill"></i>Beneficiários de Veículos</a></li>
                                        <li><a class="dropdown-item" asp-controller="LocalAssistencia" asp-action="Index"><i class="bi bi-clipboard2-pulse-fill"></i>Locais Assistência</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="parametrizacoesMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-sliders me-1"></i>Parametrizações
                                </a>
                                <ul class="dropdown-menu app-dropdown" aria-labelledby="parametrizacoesMenu">
                                    <li><h6 class="dropdown-header">Configurações da frota</h6></li>
                                    <li><a class="dropdown-item" asp-controller="TipoEvento" asp-action="Index"><i class="bi bi-calendar-event-fill"></i>Tipo Evento</a></li>
                                    <li><a class="dropdown-item" asp-controller="StatusFrota" asp-action="Index"><i class="bi bi-activity"></i>Status Frota</a></li>
                                    <li><a class="dropdown-item" asp-controller="CaracteristicaVeiculo" asp-action="Index"><i class="bi bi-diagram-3-fill"></i>Características Veículos</a></li>
                                </ul>
                            </li>
                        }

                        @if (isOperacional)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="movimentacoesMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-sliders me-1"></i>Movimentações
                                </a>
                                <ul class="dropdown-menu app-dropdown" aria-labelledby="movimentacoesMenu">
                                    <li><a class="dropdown-item" asp-controller="ReservaVeiculo" asp-action="Index"><i class="bi bi-calendar2-check-fill"></i>Reserva de Veículos</a></li>
                                    <li><a class="dropdown-item" asp-controller="HistoricoManutencao" asp-action="Index"><i class="bi bi-wrench-adjustable-circle-fill"></i>Histórico Manutenções</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="consultasMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-search me-1"></i>Consultas
                                </a>
                                <ul class="dropdown-menu app-dropdown" aria-labelledby="consultasMenu">
                                    <li><a class="dropdown-item" asp-controller="Consultas" asp-action="VeiculosDisponiveis"><i class="bi bi-car-front-fill"></i>Veículos Disponíveis</a></li>
                                    <li><a class="dropdown-item" asp-controller="Consultas" asp-action="VeiculosEmManutencao"><i class="bi bi-wrench-adjustable-circle-fill"></i>Veículos em Manutenção</a></li>
                                    <li><a class="dropdown-item" asp-controller="Consultas" asp-action="ReservasAprovadas"><i class="bi bi-calendar2-check-fill"></i>Reservas Aprovadas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Consultas" asp-action="QuilometragemAtualFrota"><i class="bi bi-speedometer2"></i>Quilometragem Atual da Frota</a></li>
                                    <li><a class="dropdown-item" asp-controller="Consultas" asp-action="ValorTotalGastoPorTipoEvento"><i class="bi bi-cash-coin"></i>Valor Total Gasto por Tipo de Evento</a></li>
                                    <li><a class="dropdown-item" asp-controller="Consultas" asp-action="BeneficiariosVeiculos"><i class="bi bi-person-vcard-fill"></i>Beneficiários de Veículos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Consultas" asp-action="RankingClientesComMaisReservas"><i class="bi bi-trophy-fill"></i>Ranking de Clientes com Mais Reservas</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="relatoriosMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-file-earmark-bar-graph me-1"></i>Relatórios
                                </a>
                                <ul class="dropdown-menu app-dropdown" aria-labelledby="relatoriosMenu">
                                    <li><a class="dropdown-item" asp-controller="Relatorio" asp-action="QuantidadeVeiculosPorFabricante"><i class="bi bi-car-front-fill"></i>Quantidade de Veículos por Fabricante</a></li>
                                    <li><a class="dropdown-item" asp-controller="Relatorio" asp-action="UtilizacaoCompletaVeiculos"><i class="bi bi-clipboard-data"></i>Completo de Utilização dos Veículos</a></li>
                                </ul>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="dashboardsMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboards
                                </a>
                                <ul class="dropdown-menu app-dropdown" aria-labelledby="dashboardsMenu">
                                    <li><h6 class="dropdown-header">Dashboard Gerencial da Frota</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="ConsultaConsolidadaIndicadores"><i class="bi bi-clipboard-data"></i>Consulta consolidada para indicadores</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <div class="navbar-status d-flex align-items-center gap-2">
                        @if (isAuthenticated)
                        {
                            <span class="status-dot"></span>
                            <span>@User.Identity?.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="ms-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm">Sair</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Entrar</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="app-shell">
        <main role="main" class="app-container page-content">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="app-container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span>&copy; 2026 Impacta Gestão de Frota</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Política de privacidade</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
