@model IEnumerable<Impacta.GestaoFrota.Application.ViewModel.HistoricoManutencaoViewModel>

@{
    ViewData["Title"] = "Histórico de Manutenções";
}

<section class="crud-page" aria-labelledby="page-title">
    <div class="crud-header">
        <div>
            <p class="crud-kicker"><i class="bi bi-wrench-adjustable-circle-fill me-2"></i>Movimentações</p>
            <h1 id="page-title" class="crud-title">Histórico de Manutenções</h1>
            <p class="crud-subtitle">Consulte e registre manutenções e eventos da frota.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary crud-action"><i class="bi bi-plus-circle me-2"></i>Novo histórico</a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success crud-alert" role="alert">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger crud-alert" role="alert">@errorMessage</div>
    }

    <div class="crud-card">
        <div class="crud-card-heading">
            <div><span class="crud-card-icon"><i class="bi bi-wrench-adjustable-circle"></i></span><span>Históricos cadastrados</span></div>
            <span class="crud-count">@Model.Count() registros</span>
        </div>
        @if (!Model.Any())
        {
            <div class="crud-empty">
                <i class="bi bi-inbox"></i>
                <h2>Nenhum histórico cadastrado</h2>
                <p>Cadastre um histórico de manutenção para acompanhar os eventos da frota.</p>
                <a asp-action="Create" class="btn btn-outline-primary">Cadastrar histórico</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table crud-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Data Evento</th>
                            <th>Local</th>
                            <th>Tipo Evento</th>
                            <th>Responsável</th>
                            <th>Cliente</th>
                            <th>Descrição do Evento</th>
                            <th class="text-end">KM</th>
                            <th class="text-end">Valor</th>
                            <th>Nota Fiscal</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.IdHistorico</td>
                                <td>@item.DataEvento?.ToString("dd/MM/yyyy")</td>
                                <td>@item.LocalNome</td>
                                <td>@item.TipoEventoNome</td>
                                <td>@item.FuncionarioResponsavelNome</td>
                                <td>@item.ClienteNome</td>
                                <td>@item.DescrEvento</td>
                                <td class="text-end">@item.Quilometragem.GetValueOrDefault().ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td>
                                <td class="text-end">@item.Valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td>
                                <td>@item.NrNotaFiscal</td>
                                <td class="text-end">
                                    <div class="crud-row-actions">
                                        <a asp-action="Edit" asp-route-id="@item.IdHistorico" class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil-square"></i><span class="visually-hidden">Editar</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdHistorico" class="btn btn-sm btn-outline-danger" title="Excluir">
                                            <i class="bi bi-trash3"></i><span class="visually-hidden">Excluir</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
