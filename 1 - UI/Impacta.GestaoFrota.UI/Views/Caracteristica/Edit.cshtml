@model Impacta.GestaoFrota.Application.ViewModel.CaracteristicaViewModel

@{
    ViewData["Title"] = "Editar característica";
}

<section class="crud-page narrow-crud-page" aria-labelledby="page-title">
    <div class="crud-header">
        <div>
            <p class="crud-kicker"><i class="bi bi-list-check me-2"></i>Características</p>
            <h1 id="page-title" class="crud-title">Editar característica</h1>
            <p class="crud-subtitle">Atualize os dados da característica selecionada.</p>
        </div>
    </div>

    <div class="crud-form-card">
        <form asp-action="Edit" method="post">
            <partial name="_Form" model="Model" />
            <div class="crud-form-actions">
                <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-2"></i>Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-2"></i>Salvar alterações</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
