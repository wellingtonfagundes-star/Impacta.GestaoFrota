@model Impacta.GestaoFrota.Application.ViewModel.VeiculoBeneficioViewModel

<div class="modal-header">
    <h5 class="modal-title" id="beneficioVeiculoModalLabel"><i class="bi bi-exclamation-triangle me-2"></i>Excluir benefício</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
</div>
<div class="modal-body">
    <div class="alert alert-warning mb-0">
        <p class="mb-2">Confirme a exclusão deste benefício:</p>
        <p class="mb-0"><strong>@Model.VeiculoDescricao</strong> — beneficiado: @Model.BeneficiadoNome; motorista: @Model.MotoristaNome</p>
    </div>
    <p class="mt-3 mb-0">Esta ação não pode ser desfeita.</p>
</div>
<form asp-action="Delete" asp-route-id="@Model.IdBeneficio" method="post" data-delete-form>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-2"></i>Excluir</button>
    </div>
</form>