@model Impacta.GestaoFrota.Application.ViewModel.ClienteViewModel

<div class="modal-header">
    <h5 class="modal-title" id="clienteModalLabel"><i class="bi bi-plus-circle me-2"></i>Novo cliente</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
</div>
<form asp-action="Create" method="post" data-modal-form>
    <div class="modal-body"><partial name="_Form" model="Model" /></div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-2"></i>Salvar cliente</button>
    </div>
</form>
