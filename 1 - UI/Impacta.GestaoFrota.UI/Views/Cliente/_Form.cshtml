@model Impacta.GestaoFrota.Application.ViewModel.ClienteViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input asp-for="IdPessoa" type="hidden" />

<div class="mb-3">
    <label asp-for="Nome" class="form-label">Nome completo / Razão social</label>
    <input asp-for="Nome" class="form-control" placeholder="Informe o nome do cliente" autofocus />
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="Endereco" class="form-label">Endereço</label>
        <input asp-for="Endereco" class="form-control" placeholder="Informe o endereço" />
        <span asp-validation-for="Endereco" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Bairro" class="form-label">Bairro</label>
        <input asp-for="Bairro" class="form-control" placeholder="Informe o bairro" />
        <span asp-validation-for="Bairro" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-5 mb-3">
        <label asp-for="Cidade" class="form-label">Cidade</label>
        <input asp-for="Cidade" class="form-control" placeholder="Informe a cidade" />
        <span asp-validation-for="Cidade" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" asp-items="ViewBag.Estados" class="form-select">
            <option value="">Selecione o estado</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Cep" class="form-label">CEP</label>
        <input asp-for="Cep" class="form-control" placeholder="Informe o CEP" />
        <span asp-validation-for="Cep" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="TipoCliente" class="form-label">Tipo de pessoa</label>
        <select asp-for="TipoCliente" class="form-select" data-tipo-cliente>
            <option value="">Selecione</option>
            <option value="PF">Pessoa Física</option>
            <option value="PJ">Pessoa Jurídica</option>
        </select>
        <span asp-validation-for="TipoCliente" class="text-danger"></span>
    </div>
    <div class="col-md-5 mb-3">
        <label asp-for="Documento" class="form-label" data-documento-label>CPF</label>
        <input asp-for="Documento" class="form-control" inputmode="numeric" autocomplete="off" data-documento-cliente data-val-documentocliente="Informe um CPF ou CNPJ válido para o tipo selecionado." placeholder="000.000.000-00" />
        <span asp-validation-for="Documento" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="Sexo" class="form-label">Sexo</label>
        <select asp-for="Sexo" class="form-select">
            <option value="">Selecione</option>
            <option value="M">Masculino</option>
            <option value="F">Feminino</option>
        </select>
        <span asp-validation-for="Sexo" class="text-danger"></span>
    </div>
</div>
